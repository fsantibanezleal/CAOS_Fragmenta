{
  "name": "fragmenta-frontend",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "scripts": {
    "predev": "node copy-data.mjs",
    "dev": "vite",
    "prebuild": "node copy-data.mjs",
    "contracts:types": "node scripts/gen-contract-types.mjs",
    "contracts:check": "node scripts/gen-contract-types.mjs --check",
    "build": "node scripts/gen-contract-types.mjs --check && tsc --noEmit && vite build",
    "postbuild": "node spa-404.mjs",
    "preview": "vite preview",
    "test": "node --import tsx --test",
    "gate:browser": "node scripts/browser-gate.mjs",
    "gate": "node scripts/gate.mjs"
  },
  "dependencies": {
    "@fasl-work/caos-app-shell": "0.18.0",
    "katex": "0.19.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "three": "0.186.1",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wait-on": "9.5.1",
    "zz-typescript5": "npm:typescript@5.9.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
