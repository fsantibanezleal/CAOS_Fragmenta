                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "minimum",
                    "maximum",
                    "target_low",
                    "target_high",
                    "n_hidden",
                    "networks"
                  ],
                  "properties": {
                    "minimum": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 7,
                      "maxItems": 7
                    },
                    "maximum": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 7,
                      "maxItems": 7
                    },
