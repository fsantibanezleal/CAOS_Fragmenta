  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}\\.\\d{3}$",
      "description": "A version in the product format X.XX.XXX."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "A SHA-256 hex digest."
    },
    "flatTree": {
      "type": "object",
      "description": "A flattened decision tree: parallel arrays indexed by node; -1 marks a leaf in left, right and feature.",
      "additionalProperties": false,
      "required": [
        "left",
        "right",
        "feature",
        "t"
      ],
      "properties": {
        "left": {
          "type": "array",
          "items": {
