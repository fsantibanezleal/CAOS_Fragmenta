              "pattern": "^\\d+\\.\\d{2}\\.\\d{3}$",
              "description": "A version in the product format X.XX.XXX."
            },
            "features": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "S_over_B"
                },
                {
                  "const": "H_over_B"
                },
                {
                  "const": "B_over_D"
                },
                {
                  "const": "T_over_B"
                },
                {
                  "const": "Pf_kg_m3"
                },
                {
                  "const": "XB_m"
                },
