{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "models-file.schema.json",
  "title": "ModelsFile",
  "description": "Contract 2 (artifact), catalog row models-file 1.0.0: the fitted arms of one training scope in the engine's portable format (blastfrag.portable/v1), written by data-pipeline/pipeline/stages/models.py to data/derived/models/<scope>.json and read by frontend/src/engine/learned.ts. The scope is the withheld site, or corpus. fixtures hold, for every arm, the prediction of the ORIGINAL fitted model at each of the shipped blasts, at full precision, so a port that drifts fails the build. digest is the SHA-256 of the canonical serialisation of the rest of the payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "portable_schema",
    "scope",
    "held_out_site",
    "n_training_rows",
    "engine",
    "app_version",
    "arms",
    "fixtures",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "fragmenta.models/v1"
    },
    "portable_schema": {
      "const": "blastfrag.portable/v1"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "held_out_site": {
      "type": [
        "string",
        "null"
      ]
    },
    "n_training_rows": {
      "type": "integer",
      "minimum": 1
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version"
      ],
      "properties": {
        "package": {
          "const": "blastfrag"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}\\.\\d{3}$",
          "description": "A version in the product format X.XX.XXX."
        }
      }
    },
    "app_version": {
      "$ref": "#/$defs/version"
    },
    "arms": {
      "type": "object",
