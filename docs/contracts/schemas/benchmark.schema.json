              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "repeated": {
                "const": true
              }
            },
            "required": [
              "repeated"
            ]
          },
          "then": {
            "properties": {
              "arms": {
                "additionalProperties": {
                  "$ref": "#/$defs/repeatedArm"
                }
              }
            }
          },
          "else": {
            "properties": {
              "arms": {
                "additionalProperties": {
                  "$ref": "#/$defs/groupedArm"
                }
              }
            }
          }
        }
      ]
